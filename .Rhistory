# Import CSV
surf_data <- read_csv("carcans_surf_data.csv")
View(surf_data)
# Nettoyage et préparation
surf_data <- surf_data %>%
separate(waves_size, into = c("waves_min", "waves_max"), sep = "-", convert = TRUE) %>%
mutate(
wind_speed = as.numeric(wind_speed),
hour = factor(hour, levels = unique(hour))
)
View(surf_data)
surf_avg_wave <- surf_data %>%
group_by(hour) %>%
summarise(waves_mean = mean((waves_min + waves_max)/2, na.rm = TRUE))
surf_avg_wave
ggplot(surf_avg_wave, aes(x = hour, y = waves_mean, group = 1)) +
geom_line(color = "blue", size = 1) +
geom_point(color = "darkblue", size = 2) +
labs(title = "Taille moyenne des vagues",
x = "Heure",
y = "Vagues (m)") +
theme_minimal()
