library(flexdashboard)
library(dplyr)
library(tidyr)
library(readr)
library(ggplot2)
library(stringr)
library(lubridate)
library(DT)
# Import CSV
surf_data <- read_csv("carcans_surf_data.csv")
View(surf_data)
# Nettoyage et préparation
surf_data <- surf_data %>%
separate(waves_size, into = c("waves_min", "waves_max"), sep = "-", convert = TRUE) %>%
# Convert wind speed to numeric
mutate(
wind_speed = as.numeric(wind_speed),
# Create wave mean
wave_mean = (waves_min + waves_max) / 2,
# Clean date format if needed
date = as.Date(date, format = "%A %d %B"),
# Order hour properly
hour = factor(hour, levels = unique(hour))
)
best_moment <- surf_data %>%
filter(
wave_mean <= 1.0,
wind_speed <= 50,
str_detect(wind_direction, "Nord")
) %>%
arrange(date, hour) %>%
slice(1)
best_text <- if(nrow(best_moment) == 0) {
"No optimal moment found"
} else {
paste(best_moment$date, "@", best_moment$hour)
}
max_wave <- max(surf_data$wave_mean, na.rm = TRUE)
max_wave
surf_avg_wave <- surf_data %>%
group_by(hour) %>%
summarise(waves_mean = mean(wave_mean, na.rm = TRUE))
valueBox(
value = best_text,
caption = "Best surf opportunity this week",
icon = "fa-star",
color = "aqua"
)
gauge(
sea_quality,
min = 0,
max = 100,
symbol = "%",
gaugeSectors(
success = c(70, 100),
warning = c(40, 70),
danger = c(0, 40)
)
)
valueBox(
value = paste0(round(max_wave,1), " m"),
caption = "Highest forecasted wave",
icon = "fa-arrow-up",
color = "blue"
)
Column {data-width=50}
#Column {data-width=50}
### 💨 Wind Speed
ggplot(surf_data, aes(x = hour, y = wind_speed, group=1)) +
geom_col(fill = "#90E0EF") +
theme_minimal(base_size = 10) +
labs(x = "Hour", y = "Wind (km/h)") +
theme(
plot.margin = margin(5,5,5,5),
axis.text.x = element_text(size = 8)
)
valueBox(
value = paste0(round(max_wave,1), " m"),
caption = "Highest forecasted wave",
icon = "fa-arrow-up",
color = "blue"
)
valueBox(
value = best_text,
caption = "Best surf opportunity this week",
icon = "fa-star",
color = "aqua"
)
library(flexdashboard)
library(dplyr)
library(tidyr)
library(readr)
library(ggplot2)
library(stringr)
library(lubridate)
library(DT)
valueBox(
value = best_text,
caption = "Best surf opportunity this week",
icon = "fa-star",
color = "aqua"
)
ggplot(surf_avg_wave, aes(x = hour, y = waves_mean, group = 1)) +
geom_area(fill = "#6EC5E9", alpha = 0.4) +
geom_line(color = "#0077B6", size = 1) +
theme_minimal(base_size = 10) +
labs(x = "Hour", y = "Wave (m)") +
theme(
plot.margin = margin(5,5,5,5),
axis.text.x = element_text(size = 8)
)
system("python run_scrap.py
